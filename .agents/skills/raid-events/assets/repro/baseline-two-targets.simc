# Учебный overlay, не historical repro; нужен player profile с нужным item/set.
# Две vulnerable цели: базовая + один duration add. HP infrastructure различается.
fight_style=Patchwerk
fixed_time=1
max_time=300
vary_combat_length=0
strict_parsing=1
active_enemies=1
ignore_invulnerable_targets=1
override.bloodlust=0
raid_events=/adds,name=ControlAdd_P01,count=1,timestamps=0,cooldown=5160,duration=301,duration_min=301,duration_max=301
